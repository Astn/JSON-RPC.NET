<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway evaluation: is a simdjson binding faster than the built-in jsmn tokenizer on the
       JSON-RPC envelope workload? Not part of the solution, not packed, not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SimdJson.Net" Version="4.6.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Json-Rpc\AustinHarris.JsonRpc.csproj" />
  </ItemGroup>

</Project>
