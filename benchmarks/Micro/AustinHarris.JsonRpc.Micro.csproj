<Project Sdk="Microsoft.NET.Sdk">

  <!-- Micro-benchmarks for the dispatch path with BenchmarkDotNet: nanosecond timings with statistics and an
       allocation column per request shape. TestServer_Console's sweep measures throughput under load; this
       measures one request on one core, which is what a change to the fast path is judged by.
       Not part of the solution, not packed, not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
    <!-- LifetimeBenchmarks only: a real container scope around a document, as the AspNetCore host creates it -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Json-Rpc\AustinHarris.JsonRpc.csproj" />
  </ItemGroup>

</Project>
